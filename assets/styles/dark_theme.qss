/* ==========================================================================
   FileX — Premium Commercial Dark Theme Stylesheet (QSS)
   Linear / Raycast / Windows 11 Fluent inspired
   ========================================================================== */

/* --------------------------------------------------------------------------
   Global Application Styles
   -------------------------------------------------------------------------- */
* {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
    color: #F5F5FA;
    selection-background-color: #8957FF;
    selection-color: #FFFFFF;
    outline: none;
}

QWidget {
    background-color: #0F111A;
    color: #F5F5FA;
}

/* --------------------------------------------------------------------------
   Main Window & Frames
   -------------------------------------------------------------------------- */
QMainWindow {
    background-color: #0B0D14;
}

QDialog {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 12px;
}

QFrame#sidebarFrame {
    background-color: #10121C;
    border-right: 1px solid #1D2030;
}

QFrame#cardFrame, QFrame.card {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 12px;
}

QFrame#cardFrame:hover, QFrame.card:hover {
    border: 1px solid #383D56;
}

QFrame#elevatedCard {
    background-color: #1D2030;
    border: 1px solid #292D40;
    border-radius: 10px;
}

/* --------------------------------------------------------------------------
   Buttons & Action Controls
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #1D2030;
    border: 1px solid #292D40;
    border-radius: 8px;
    color: #F5F5FA;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #25293D;
    border-color: #383D56;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #171A27;
    border-color: #8957FF;
}

QPushButton:disabled {
    background-color: #131520;
    border-color: #1F2232;
    color: #687087;
}

/* Primary Vibrant Action Button */
QPushButton#primaryButton, QPushButton[primary="true"] {
    background-color: #8957FF;
    border: 1px solid #9D71FF;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: 700;
    padding: 9px 20px;
}

QPushButton#primaryButton:hover, QPushButton[primary="true"]:hover {
    background-color: #9D71FF;
    border-color: #B594FF;
    color: #FFFFFF;
}

QPushButton#primaryButton:pressed, QPushButton[primary="true"]:pressed {
    background-color: #7843E6;
    border-color: #6632D2;
}

/* Secondary Button */
QPushButton#secondaryButton {
    background-color: #1D2030;
    border: 1px solid #292D40;
    color: #F5F5FA;
}

QPushButton#secondaryButton:hover {
    background-color: #25293D;
    border-color: #8957FF;
    color: #FFFFFF;
}

/* Ghost Button */
QPushButton#ghostButton {
    background-color: transparent;
    border: none;
    color: #9CA3B8;
}

QPushButton#ghostButton:hover {
    background-color: #171A27;
    color: #F5F5FA;
}

/* Danger / Cancel Button */
QPushButton#dangerButton {
    background-color: #2A171D;
    border: 1px solid #4C1D24;
    color: #EF4444;
}

QPushButton#dangerButton:hover {
    background-color: #381A22;
    border-color: #EF4444;
    color: #FCA5A5;
}

/* Sidebar Navigation Buttons */
QPushButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #9CA3B8;
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#navButton:hover {
    background-color: #171A27;
    color: #F5F5FA;
}

QPushButton#navButton:checked, QPushButton#navButton[active="true"] {
    background-color: #1D2030;
    border-left: 3px solid #8957FF;
    color: #FFFFFF;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   Input Fields & Combo Boxes
   -------------------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #12141F;
    border: 1px solid #292D40;
    border-radius: 8px;
    padding: 8px 12px;
    color: #F5F5FA;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #8957FF;
    background-color: #151826;
}

QComboBox {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 8px;
    padding: 7px 12px;
    color: #F5F5FA;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #383D56;
}

QComboBox:focus {
    border-color: #8957FF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left-width: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 8px;
    padding: 4px;
    color: #F5F5FA;
    selection-background-color: #8957FF;
    selection-color: #FFFFFF;
}

/* --------------------------------------------------------------------------
   Progress Bar
   -------------------------------------------------------------------------- */
QProgressBar {
    background-color: #12141F;
    border: 1px solid #292D40;
    border-radius: 6px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8957FF, stop:1 #A78BFA);
    border-radius: 5px;
}

/* --------------------------------------------------------------------------
   Table & Tree Views
   -------------------------------------------------------------------------- */
QTableWidget, QTableView {
    background-color: #12141F;
    border: 1px solid #292D40;
    border-radius: 10px;
    gridline-color: #1D2030;
    color: #F5F5FA;
    selection-background-color: #1D2030;
    selection-color: #FFFFFF;
}

QTableWidget::item, QTableView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1D2030;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #1D2030;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #10121C;
    color: #9CA3B8;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #292D40;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --------------------------------------------------------------------------
   Checkboxes & Switches
   -------------------------------------------------------------------------- */
QCheckBox {
    spacing: 10px;
    color: #CBD5E1;
    font-size: 13px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #292D40;
    background-color: #12141F;
}

QCheckBox::indicator:hover {
    border-color: #8957FF;
}

QCheckBox::indicator:checked {
    background-color: #8957FF;
    border-color: #8957FF;
}

/* --------------------------------------------------------------------------
   Scrollbars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background-color: #0F111A;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #292D40;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #383D56;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #0F111A;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #292D40;
    min-width: 25px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #383D56;
}

/* --------------------------------------------------------------------------
   Labels & Typography
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #F5F5FA;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: 700;
    color: #F5F5FA;
}

QLabel#subtitleLabel {
    font-size: 13px;
    color: #9CA3B8;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #F5F5FA;
}

QLabel#metricValue {
    font-size: 30px;
    font-weight: 800;
    color: #F5F5FA;
}

QLabel#metricLabel {
    font-size: 11px;
    font-weight: 600;
    color: #687087;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --------------------------------------------------------------------------
   Tooltips & Menus
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 6px;
    color: #F5F5FA;
    padding: 6px 10px;
    font-size: 12px;
}

QMenu {
    background-color: #171A27;
    border: 1px solid #292D40;
    border-radius: 8px;
    padding: 6px;
    color: #F5F5FA;
}

QMenu::item {
    padding: 6px 20px 6px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1D2030;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #292D40;
    margin: 4px 6px;
}
