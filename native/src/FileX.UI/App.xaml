<Application x:Class="FileX.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Accent Colors (Purple & Blue) -->
            <SolidColorBrush x:Key="FileXAccentPurple" Color="#7C4DFF" />
            <SolidColorBrush x:Key="FileXAccentBlue" Color="#38BDF8" />
            <SolidColorBrush x:Key="FileXCardBackground" Color="#1E1F30" />
            <SolidColorBrush x:Key="FileXCardBorder" Color="#2D304A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
