<ui:FluentWindow x:Class="FileX.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FileX — Universal File Converter"
        Height="700"
        Width="1060"
        MinHeight="580"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="FileX — Universal File Converter"
                     Icon="/Assets/logo.png" />

        <!-- Main Content Area with Sidebar Navigation -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#141522" BorderBrush="#232536" BorderThickness="0,0,1,0" Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="20" Foreground="#7C4DFF" VerticalAlignment="Center" />
                            <TextBlock Text="FileX" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Border Background="#272844" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Universal File Converter" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <ui:Button x:Name="NavDashboard"
                                   Content="📊  Dashboard"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Click="NavDashboard_Click" />

                        <ui:Button x:Name="NavConvert"
                                   Content="⚡  Convert"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Click="NavConvert_Click" />

                        <ui:Button x:Name="NavHistory"
                                   Content="🕒  History"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Click="NavHistory_Click" />

                        <ui:Button x:Name="NavSettings"
                                   Content="⚙  Settings"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Click="NavSettings_Click" />
                    </StackPanel>

                    <!-- Bottom Floating Widget Quick Toggle Pill -->
                    <Border Grid.Row="2" Background="#1A1B2B" BorderBrush="#292B3E" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Floating Widget" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                            <ui:Button x:Name="BtnToggleWidget"
                                       Content="Hide Widget"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       FontSize="11"
                                       Padding="0,6"
                                       Click="ToggleWidget_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Page Content Frame -->
            <Frame Grid.Column="1" x:Name="RootFrame" NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</ui:FluentWindow>
