<ui:FluentWindow x:Class="FileX.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FileX — Universal File Converter"
        Height="700"
        Width="1060"
        MinHeight="580"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="#0B0D14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="FileX — Universal File Converter"
                     Icon="/Assets/logo.png" />

        <!-- Main layout: Sidebar + Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#10121C"
                    BorderBrush="#1A1D2E"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: Logo + Name -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="FX"
                                       FontSize="22"
                                       FontWeight="ExtraBold"
                                       Foreground="#8957FF"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" FileX"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F5F5FA"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Universal File Converter"
                                   FontSize="11"
                                   Foreground="#687087" />
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <ui:Button x:Name="NavDashboard"
                                   Content="  Dashboard"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Margin="0,0,0,2"
                                   Click="NavDashboard_Click" />

                        <ui:Button x:Name="NavConvert"
                                   Content="  Convert Files"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Margin="0,0,0,2"
                                   Click="NavConvert_Click" />

                        <ui:Button x:Name="NavHistory"
                                   Content="  History"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Margin="0,0,0,2"
                                   Click="NavHistory_Click" />

                        <ui:Button x:Name="NavSettings"
                                   Content="  Settings"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Padding="14,10"
                                   FontSize="13"
                                   Margin="0,0,0,2"
                                   Click="NavSettings_Click" />
                    </StackPanel>

                    <!-- Footer: Widget toggle + version -->
                    <Border Grid.Row="2"
                            Background="#171A27"
                            BorderBrush="#292D40"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Floating Widget"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#9CA3B8"
                                       Margin="0,0,0,8" />
                            <ui:Button x:Name="BtnToggleWidget"
                                       Content="Hide Widget"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Stretch"
                                       FontSize="11"
                                       Padding="0,6"
                                       Click="ToggleWidget_Click" />
                            <TextBlock Text="v1.0.0"
                                       FontSize="10"
                                       Foreground="#687087"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Frame -->
            <Frame Grid.Column="1"
                   x:Name="RootFrame"
                   NavigationUIVisibility="Hidden"
                   Background="#0F111A" />
        </Grid>
    </Grid>
</ui:FluentWindow>
