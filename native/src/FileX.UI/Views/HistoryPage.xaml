<Page x:Class="FileX.UI.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="History">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Action Row -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Conversion History" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="Track and access previously converted files and their locations." Foreground="#94A3B8" />
            </StackPanel>

            <ui:Button Content="🗑  Clear History"
                       Appearance="Danger"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Click="ClearHistory_Click" />
        </Grid>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <ui:TextBox x:Name="SearchBox"
                        PlaceholderText="🔍  Search by file name or format…"
                        TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- History DataGrid -->
        <DataGrid Grid.Row="2"
                  x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="#161726"
                  BorderBrush="#282A44"
                  RowBackground="#1A1B2B"
                  AlternatingRowBackground="#161726"
                  Foreground="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding SourceFileName}" Width="*" />
                <DataGridTextColumn Header="Format" Binding="{Binding OutputFormat}" Width="100" />
                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150" />
                <DataGridTextColumn Header="Size" Binding="{Binding FormattedSizeOut}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />

                <!-- Action Buttons Column -->
                <DataGridTemplateColumn Header="Actions" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button Content="Open"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           FontSize="11"
                                           Click="OpenRecordFile_Click" />
                                <ui:Button Content="Folder"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           FontSize="11"
                                           Click="OpenRecordFolder_Click" />
                                <ui:Button Content="✕"
                                           Appearance="Danger"
                                           Padding="6,2"
                                           FontSize="11"
                                           Click="DeleteRecord_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
