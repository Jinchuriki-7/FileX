<Page x:Class="FileX.UI.Views.ConvertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Convert"
      Background="#0F111A">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Convert Files"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#F5F5FA"
                       Margin="0,0,0,4" />
            <TextBlock Text="Drag files from Windows Explorer or click to browse from your computer."
                       FontSize="13"
                       Foreground="#9CA3B8" />
        </StackPanel>

        <!-- Drop Zone -->
        <Border Grid.Row="1"
                x:Name="DropZoneBorder"
                Background="#12141F"
                BorderBrush="#292D40"
                BorderThickness="2"
                CornerRadius="12"
                AllowDrop="True"
                Cursor="Hand"
                Drop="DropZone_Drop"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                MouseDown="DropZone_MouseDown">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Upload icon using a bordered circle-like element -->
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        BorderBrush="#8957FF"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock x:Name="TxtDropIcon"
                               Text="+"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#8957FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TxtDropTitle"
                           Text="Drop files here to convert"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F5F5FA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <TextBlock Text="or click to browse from your computer"
                           FontSize="12"
                           Foreground="#9CA3B8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Images  •  Documents  •  PDFs  •  Spreadsheets  •  Audio  •  Video"
                           FontSize="11"
                           Foreground="#687087"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Queue Section Header -->
        <TextBlock Grid.Row="2"
                   Text="Active &amp; Recent Conversions"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#F5F5FA"
                   Margin="0,20,0,12" />

        <!-- Queue Task Cards -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TaskQueuePanel" />
        </ScrollViewer>
    </Grid>
</Page>
