<Page x:Class="FileX.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Background="#0F111A">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="720" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F5F5FA"
                           Margin="0,0,0,4" />
                <TextBlock Text="Customize application preferences, output directories, and Windows integration."
                           FontSize="13"
                           Foreground="#9CA3B8" />
            </StackPanel>

            <!-- Section A: Floating Widget -->
            <Border Background="#171A27"
                    BorderBrush="#292D40"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Floating Widget"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F5F5FA"
                               Margin="0,0,0,16" />

                    <CheckBox x:Name="ChkShowFloatingWidget"
                              Content="Show Floating Widget on desktop"
                              Foreground="#CBD5E1"
                              Margin="0,0,0,8"
                              Checked="ChkShowFloatingWidget_Changed"
                              Unchecked="ChkShowFloatingWidget_Changed" />

                    <CheckBox x:Name="ChkAlwaysOnTop"
                              Content="Keep Widget always on top"
                              Foreground="#CBD5E1"
                              Margin="0,0,0,16"
                              Checked="ChkAlwaysOnTop_Changed"
                              Unchecked="ChkAlwaysOnTop_Changed" />

                    <!-- Opacity slider -->
                    <StackPanel Margin="0,0,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Widget Opacity:"
                                       FontSize="13"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtOpacityValue"
                                       Text="95%"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#8957FF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="SliderOpacity"
                                Minimum="40"
                                Maximum="100"
                                Value="95"
                                ValueChanged="SliderOpacity_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section B: Output & Files -->
            <Border Background="#171A27"
                    BorderBrush="#292D40"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Output &amp; Files"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F5F5FA"
                               Margin="0,0,0,16" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Default Output Folder:"
                                   FontSize="13"
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtOutputFolder"
                                        IsReadOnly="True"
                                        Background="#12141F"
                                        BorderBrush="#292D40"
                                        Foreground="#F5F5FA"
                                        Padding="10,8" />
                            <ui:Button Grid.Column="1"
                                       Content="Browse..."
                                       Appearance="Secondary"
                                       Margin="8,0,0,0"
                                       Padding="14,8"
                                       Click="BrowseOutputFolder_Click" />
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="ChkOpenAfter"
                              Content="Open containing folder automatically after conversion finishes"
                              Foreground="#CBD5E1"
                              Margin="0,8,0,0"
                              Checked="ChkOpenAfter_Changed"
                              Unchecked="ChkOpenAfter_Changed" />

                    <CheckBox x:Name="ChkOverwrite"
                              Content="Overwrite existing files without renaming"
                              Foreground="#CBD5E1"
                              Margin="0,8,0,0"
                              Checked="ChkOverwrite_Changed"
                              Unchecked="ChkOverwrite_Changed" />
                </StackPanel>
            </Border>

            <!-- Section C: Windows & System -->
            <Border Background="#171A27"
                    BorderBrush="#292D40"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Windows &amp; System"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F5F5FA"
                               Margin="0,0,0,16" />

                    <CheckBox x:Name="ChkStartup"
                              Content="Start FileX automatically with Windows"
                              Foreground="#CBD5E1"
                              Margin="0,0,0,0"
                              Checked="ChkStartup_Changed"
                              Unchecked="ChkStartup_Changed" />

                    <CheckBox x:Name="ChkNotifications"
                              Content="Show desktop notifications on conversion completion"
                              Foreground="#CBD5E1"
                              Margin="0,8,0,0"
                              Checked="ChkNotifications_Changed"
                              Unchecked="ChkNotifications_Changed" />

                    <CheckBox x:Name="ChkStartMinimised"
                              Content="Start minimized to System Tray"
                              Foreground="#CBD5E1"
                              Margin="0,8,0,0"
                              Checked="ChkStartMinimised_Changed"
                              Unchecked="ChkStartMinimised_Changed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
