<Page x:Class="FileX.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <!-- Welcome Banner -->
            <ui:Card Padding="24" Background="#1D1A30" BorderBrush="#3B2D6B" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Welcome to FileX" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Fast, modern, native Windows file conversion engine. Convert images, documents, PDFs, spreadsheets, audio, and video offline with zero quality loss."
                                   TextWrapping="Wrap" Foreground="#CBD5E1" MaxWidth="650" LineHeight="20" />
                        <ui:Button Content="⚡  Start Converting Files"
                                   Appearance="Primary"
                                   Background="#7C4DFF"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   Padding="16,10"
                                   Margin="0,8,0,0"
                                   Click="StartConverting_Click" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="⚡" FontSize="64" Foreground="#7C4DFF" VerticalAlignment="Center" Margin="24,0,12,0" />
                </Grid>
            </ui:Card>

            <!-- Metrics Overview Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Conversions -->
                <ui:Card Grid.Column="0" Margin="0,0,10,0" Padding="20,16" Background="#1A1B2B" BorderBrush="#282A44">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotal" Text="0" FontSize="28" FontWeight="ExtraBold" Foreground="#7C4DFF" />
                        <TextBlock Text="TOTAL CONVERSIONS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                    </StackPanel>
                </ui:Card>

                <!-- Success Rate -->
                <ui:Card Grid.Column="1" Margin="5,0,5,0" Padding="20,16" Background="#1A1B2B" BorderBrush="#282A44">
                    <StackPanel>
                        <TextBlock x:Name="TxtSuccessRate" Text="100%" FontSize="28" FontWeight="ExtraBold" Foreground="#10B981" />
                        <TextBlock Text="SUCCESS RATE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                    </StackPanel>
                </ui:Card>

                <!-- Data Processed -->
                <ui:Card Grid.Column="2" Margin="10,0,0,0" Padding="20,16" Background="#1A1B2B" BorderBrush="#282A44">
                    <StackPanel>
                        <TextBlock x:Name="TxtVolume" Text="0 MB" FontSize="28" FontWeight="ExtraBold" Foreground="#38BDF8" />
                        <TextBlock Text="DATA PROCESSED" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Supported Categories Section -->
            <StackPanel>
                <TextBlock Text="Supported Format Categories" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />

                <WrapPanel x:Name="CategoryPanel" ItemWidth="200" ItemHeight="110" Margin="0,4,0,0">
                    <!-- Populated in code-behind -->
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
