<Page x:Class="FileX.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard"
      Background="#0F111A">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- Page Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Good morning"
                           FontSize="12"
                           Foreground="#687087"
                           Margin="0,0,0,4" />
                <TextBlock Text="Welcome back to FileX."
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F5F5FA"
                           Margin="0,0,0,4" />
                <TextBlock Text="Your files, converted effortlessly."
                           FontSize="13"
                           Foreground="#9CA3B8" />
            </StackPanel>

            <!-- Hero Gradient Card -->
            <Border BorderBrush="#8957FF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24"
                    Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1035" Offset="0" />
                        <GradientStop Color="#0F1628" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left content -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Convert anything. Keep everything local."
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F5F5FA"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Fast, private and powerful file conversion directly on your device."
                                   FontSize="13"
                                   Foreground="#9CA3B8"
                                   TextWrapping="Wrap"
                                   MaxWidth="400" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Content="Start Converting"
                                       Appearance="Primary"
                                       Background="#8957FF"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       Padding="14,8"
                                       Margin="0,0,10,0"
                                       Click="StartConverting_Click" />
                            <ui:Button Content="View History"
                                       Appearance="Secondary"
                                       Padding="14,8" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right accent symbol -->
                    <TextBlock Grid.Column="1"
                               Text="FX"
                               FontSize="56"
                               FontWeight="ExtraBold"
                               Foreground="#8957FF"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="24,0,12,0" />
                </Grid>
            </Border>

            <!-- Stats Row: 3 cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Conversions -->
                <Border Grid.Column="0"
                        Background="#171A27"
                        BorderBrush="#292D40"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotal"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#8957FF"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Total Conversions"
                                   FontSize="11"
                                   Foreground="#687087" />
                    </StackPanel>
                </Border>

                <!-- Success Rate -->
                <Border Grid.Column="1"
                        Background="#171A27"
                        BorderBrush="#292D40"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtSuccessRate"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#22C55E"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Successful"
                                   FontSize="11"
                                   Foreground="#687087" />
                    </StackPanel>
                </Border>

                <!-- Data Processed -->
                <Border Grid.Column="2"
                        Background="#171A27"
                        BorderBrush="#292D40"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtVolume"
                                   Text="0 MB"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Data Processed"
                                   FontSize="11"
                                   Foreground="#687087" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Supported Formats Section -->
            <StackPanel>
                <TextBlock Text="Supported Formats"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F5F5FA"
                           Margin="0,0,0,12" />
                <WrapPanel x:Name="CategoryPanel"
                           ItemWidth="175"
                           ItemHeight="90"
                           Margin="0,0,0,0">
                    <!-- Populated in code-behind -->
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
