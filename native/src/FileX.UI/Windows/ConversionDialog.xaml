<Window x:Class="FileX.UI.Windows.ConversionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Convert File"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#171A27"
            BorderBrush="#292D40"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="4"
                              Opacity="0.7"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Dialog Title Bar -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FX"
                               FontSize="14"
                               FontWeight="ExtraBold"
                               Foreground="#8957FF"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Convert File"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#F5F5FA"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Content="x"
                           Appearance="Transparent"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,2"
                           FontSize="13"
                           Click="Cancel_Click" />
            </Grid>

            <!-- File Summary Card -->
            <Border Background="#1D2030"
                    BorderBrush="#292D40"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCategoryIcon"
                               Text="[  ]"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#8957FF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileName"
                                   Text="file.png"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#F5F5FA"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2" />
                        <TextBlock x:Name="TxtFileMeta"
                                   Text="120 KB  •  Image (PNG)"
                                   FontSize="11"
                                   Foreground="#9CA3B8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Target Format Selection -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Select Target Format:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="ComboFormats"
                          Height="36"
                          Background="#12141F"
                          BorderBrush="#292D40"
                          Foreground="#F5F5FA" />
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Content="Cancel"
                           Appearance="Secondary"
                           Padding="14,8"
                           Margin="0,0,6,0"
                           HorizontalAlignment="Stretch"
                           Click="Cancel_Click" />
                <ui:Button Grid.Column="1"
                           x:Name="BtnConvert"
                           Content="Convert Now"
                           Appearance="Primary"
                           Background="#8957FF"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           Padding="14,8"
                           Margin="6,0,0,0"
                           HorizontalAlignment="Stretch"
                           Click="Convert_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
