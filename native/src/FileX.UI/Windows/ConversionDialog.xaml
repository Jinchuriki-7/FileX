<Window x:Class="FileX.UI.Windows.ConversionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Convert File"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#181926" BorderBrush="#32354F" BorderThickness="1" CornerRadius="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Title Bar -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="16" Foreground="#7C4DFF" VerticalAlignment="Center" />
                    <TextBlock Text="Convert File" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Content="✕" Appearance="Transparent" HorizontalAlignment="Right" Padding="6,2" Click="Cancel_Click" />
            </Grid>

            <!-- File Summary Card -->
            <ui:Card Padding="14" Background="#1F2033" BorderBrush="#2D304A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCategoryIcon" Text="📄" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TxtFileName" Text="file.png" FontWeight="Bold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtFileMeta" Text="120 KB • Image (PNG)" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Target Format Selection -->
            <StackPanel>
                <TextBlock Text="Select Target Format:" FontWeight="SemiBold" Foreground="#CBD5E1" FontSize="12" />
                <ComboBox x:Name="ComboFormats" Height="36" />
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,6,0" Click="Cancel_Click" />
                <ui:Button Grid.Column="1"
                           x:Name="BtnConvert"
                           Content="Convert Now"
                           Appearance="Primary"
                           Background="#7C4DFF"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           Margin="6,0,0,0"
                           Click="Convert_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
