<Window x:Class="FileX.UI.Windows.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileX Floating Widget"
        Width="140"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    <Window.ContextMenu>
        <ContextMenu Background="#1A1B2B" Foreground="#F1F5F9" BorderBrush="#32354F">
            <MenuItem Header="📊  Open Dashboard" Click="OpenDashboard_Click" />
            <Separator Background="#282A44" />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="📌  Always on Top" IsCheckable="True" IsChecked="True" Click="ToggleTopmost_Click" />
            <MenuItem Header="👁️  Hide Floating Widget" Click="HideWidget_Click" />
            <Separator Background="#282A44" />
            <MenuItem Header="🚪  Exit FileX" Click="ExitApp_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="10">
        <!-- Circular Outer Glow / Shadow -->
        <Border x:Name="OuterCircle"
                CornerRadius="60"
                Background="#EE1A1B2C"
                BorderBrush="#7C4DFF"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect x:Name="CircleShadow" BlurRadius="20" ShadowDepth="2" Opacity="0.7" Color="#7C4DFF" />
            </Border.Effect>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Idle State Content -->
                <StackPanel x:Name="IdleState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="FX" FontSize="20" FontWeight="ExtraBold" Foreground="#A78BFA" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop file" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Drag Hover State Content -->
                <StackPanel x:Name="DragState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" Foreground="#38BDF8" HorizontalAlignment="Center" />
                    <TextBlock Text="Release" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Processing State Content -->
                <StackPanel x:Name="ProcessingState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="Converting" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
