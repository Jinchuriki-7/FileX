<Window x:Class="FileX.UI.Windows.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileX Floating Widget"
        Width="120"
        Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    <Window.ContextMenu>
        <ContextMenu Background="#171A27"
                     Foreground="#F5F5FA"
                     BorderBrush="#292D40"
                     BorderThickness="1">
            <MenuItem Header="Open Dashboard" Click="OpenDashboard_Click" />
            <Separator Background="#292D40" />
            <MenuItem x:Name="MenuAlwaysOnTop"
                      Header="Always on Top"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="ToggleTopmost_Click" />
            <MenuItem Header="Hide Floating Widget" Click="HideWidget_Click" />
            <Separator Background="#292D40" />
            <MenuItem Header="Exit FileX" Click="ExitApp_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="10">
        <!-- Circular Outer Border with Glow -->
        <Border x:Name="OuterCircle"
                CornerRadius="60"
                Background="#E61A1D2C"
                BorderBrush="#8957FF"
                BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect x:Name="CircleShadow"
                                  BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.65"
                                  Color="#8957FF" />
            </Border.Effect>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Idle State -->
                <StackPanel x:Name="IdleState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="FX"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#A78BFA"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Drop file"
                               FontSize="9"
                               Foreground="#687087"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Drag State -->
                <StackPanel x:Name="DragState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="v"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Release!"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Processing State -->
                <StackPanel x:Name="ProcessingState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProgressPct"
                               Text="0%"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Converting"
                               FontSize="9"
                               Foreground="#9CA3B8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
